#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = "purge" ]; then
  rm -f /etc/speedbackup-server/server.env
  rmdir /etc/speedbackup-server 2>/dev/null || true
  echo "SpeedBackup data preserved in /var/lib/speedbackup-server"
fi
exit 0
